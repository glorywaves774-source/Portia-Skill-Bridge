# Copy to .env for local development. Never commit .env.
APP_ENV=development                 # development | testing | production
SECRET_KEY=change-me-to-a-long-random-string   # python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=postgresql://postgres@localhost:5432/skillbridge
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/skillbridge_test   # optional; tests use SQLite if unset

# Optional
RATELIMIT_STORAGE_URI=memory://     # use redis://... when running several workers
RATELIMIT_DEFAULT=300 per minute
BILLING_GRACE_DAYS=7
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO

# Email (password resets). In development, log writes emails to the server log.
MAIL_BACKEND=log                    # log | smtp
MAIL_FROM=PORTIA SkillBridge <no-reply@yourdomain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SALES_EMAIL=                        # shows "Contact sales" on the Enterprise plan

# Sign-in throttling per IP address
LOGIN_RATE_LIMIT=10 per minute;50 per hour
SIGNUP_RATE_LIMIT=5 per hour
RESET_RATE_LIMIT=5 per hour

# File storage for photos and documents
STORAGE_BACKEND=local               # local (development) | s3 (production)
UPLOAD_ROOT=                        # local only; default instance/uploads
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=               # e.g. https://<account>.r2.cloudflarestorage.com (blank for AWS)
STORAGE_REGION=                     # e.g. auto (R2) or eu-west-1 (AWS)
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Paystack online payment (Mobile Money and cards)
# Use a test key (sk_test_…) until you're ready, then the live key (sk_live_…).
# Webhook URL to set in the Paystack dashboard: https://<your-site>/webhooks/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=                # not needed by the server; kept for reference
PAYSTACK_BACKEND=                   # blank = automatic; "fake" = practice checkout (never in production)
